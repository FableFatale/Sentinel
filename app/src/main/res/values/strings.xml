    <string name="accessibility_watch_desc">Observes window switches and system permission dialogs to keep a local record of permission activity. Does not read or store the screen content of other apps.</string>

    <!-- Independent access setup guide: one card per system switch, vendor paths spelled out. -->
    <string name="access_guide_note">Two independent system switches. Enable either or both — each one adds its own data source.</string>
    <string name="usage_access_desc">Powers the timeline and activity heatmap with real foreground sessions. Without it the app shows live camera and microphone state only.</string>
    <string name="permission_watch_desc">Records system permission dialogs and app switches locally. Fully optional and off by default.</string>
